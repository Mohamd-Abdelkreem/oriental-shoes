  id                                String                 @id @default(uuid()) @db.Uuid
  orderId                           String                 @map("order_id") @db.Uuid
  pieceId                           String                 @map("piece_id") @db.Uuid
  cycle                             Int
  rejectionEventId                  String                 @unique(map: "quality_correction_cycles_rejection_event_key") @map("rejection_event_id") @db.Uuid
  target                            Department
  reason                            String                 @db.VarChar(4000)
  instructions                      String                 @db.VarChar(4000)
  state                             QualityCycleState
  resolvedAt                        DateTime?              @map("resolved_at") @db.Timestamptz(6)
  resolutionQualityEventId          String?                @map("resolution_quality_event_id") @db.Uuid
  resolutionApprovalCommandId       String?                @map("resolution_approval_command_id") @db.Uuid
  piece                             SalesOrderPiece        @relation("QualityCorrectionPiece", fields: [pieceId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)
  rejectionEvent                    QualityPieceEvent      @relation("QualityCycleRejection", fields: [rejectionEventId, orderId, pieceId], references: [id, orderId, pieceId], onDelete: Restrict, onUpdate: NoAction, map: "quality_correction_cycles_rejection_fkey")
  resolutionQualityEvent            QualityPieceEvent?     @relation("QualityCycleResolution", fields: [resolutionQualityEventId, orderId, pieceId], references: [id, orderId, pieceId], onDelete: Restrict, onUpdate: NoAction, map: "quality_correction_cycles_resolution_event_fkey")
  resolutionApprovalCommand         ApprovalCommand?       @relation("QualityCycleApprovalResolution", fields: [resolutionApprovalCommandId], references: [commandId], onDelete: Restrict, onUpdate: NoAction)
  events                            QualityPieceEvent[]    @relation("QualityEventCorrection")
  sourcedVisits                     QualityWorkVisit[]     @relation("QualityVisitCorrection")
  resolutionAdministrationCommandId String?                @map("resolution_administration_command_id") @db.Uuid
  resolutionAdministrationCommand   AdministrationCommand? @relation("QualityCycleAdministrationResolution", fields: [resolutionAdministrationCommandId], references: [commandId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([id, orderId, pieceId], map: "quality_correction_cycles_id_order_piece_key")
  @@unique([pieceId, cycle], map: "quality_correction_cycles_piece_cycle_key")
  @@index([orderId, pieceId, cycle(sort: Desc)], map: "quality_correction_cycles_order_piece_cycle_idx")
  @@index([state, orderId, pieceId], map: "quality_correction_cycles_state_order_piece_idx")
  @@map("quality_correction_cycles")
}

model QualityPackingGroup {
  id            String                @id @default(uuid()) @db.Uuid
  commandId     String                @map("command_id") @db.Uuid
  orderId       String                @map("order_id") @db.Uuid
  cartonCount   String?               @map("carton_count") @db.VarChar(4000)
  cartonNumbers String?               @map("carton_numbers") @db.VarChar(4000)
  commandOrder  QualityCommandOrder   @relation(fields: [commandId, orderId], references: [commandId, orderId], onDelete: Restrict, onUpdate: NoAction)
  pieces        QualityPackingPiece[]

  @@unique([commandId, orderId], map: "quality_packing_groups_command_order_key")
  @@unique([id, commandId, orderId], map: "quality_packing_groups_id_command_order_key")
  @@map("quality_packing_groups")
}

model QualityPackingPiece {
  groupId   String              @map("group_id") @db.Uuid
  commandId String              @map("command_id") @db.Uuid
  orderId   String              @map("order_id") @db.Uuid
  pieceId   String              @map("piece_id") @db.Uuid
  group     QualityPackingGroup @relation(fields: [groupId, commandId, orderId], references: [id, commandId, orderId], onDelete: Restrict, onUpdate: NoAction, map: "quality_packing_pieces_group_fkey")
  event     QualityPieceEvent   @relation(fields: [commandId, orderId, pieceId], references: [commandId, orderId, pieceId], onDelete: Restrict, onUpdate: NoAction, map: "quality_packing_pieces_event_fkey")

  @@id([groupId, pieceId], map: "quality_packing_pieces_pkey")
  @@unique([commandId, pieceId], map: "quality_packing_pieces_command_piece_key")
  @@map("quality_packing_pieces")
}

model QualityApprovalReport {
  commandId         String            @map("command_id") @db.Uuid
  orderId           String            @map("order_id") @db.Uuid
  pieceId           String            @map("piece_id") @db.Uuid
  approvalCommandId String            @unique(map: "quality_approval_reports_approval_command_key") @map("approval_command_id") @db.Uuid
  ordinal           Int
  event             QualityPieceEvent @relation(fields: [commandId, orderId, pieceId], references: [commandId, orderId, pieceId], onDelete: Restrict, onUpdate: NoAction, map: "quality_approval_reports_event_fkey")
  approvalCommand   ApprovalCommand   @relation("QualityReportChild", fields: [approvalCommandId], references: [commandId], onDelete: Restrict, onUpdate: NoAction)

  @@id([commandId, pieceId], map: "quality_approval_reports_pkey")
  @@unique([commandId, orderId, ordinal], map: "quality_approval_reports_order_ordinal_key")
  @@map("quality_approval_reports")
}

enum WarehouseOperation {
  RECEIVE
  DISPATCH
  CONFIRM_DELIVERY
  FAIL_DELIVERY
  RETRY_DELIVERY

  @@map("warehouse_operation")
}

enum WarehouseReceiptOrigin {
  COMMAND
  LEGACY_BASELINE

  @@map("warehouse_receipt_origin")
}

model WarehouseCommand {
  commandId       String                  @id @map("command_id") @db.Uuid
  operation       WarehouseOperation
  actorId         String                  @map("actor_id") @db.Uuid
  actorFullName   String                  @map("actor_full_name") @db.VarChar(150)
  actorRole       UserRole                @map("actor_role")
  actorDepartment Department?             @map("actor_department")
  payloadHash     String                  @map("payload_hash") @db.Char(64)
  occurredAt      DateTime                @map("occurred_at") @db.Timestamptz(6)
  outcome         Json                    @db.JsonB
  actor           User                    @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orders          WarehouseCommandOrder[]

  @@index([actorId, occurredAt(sort: Desc), commandId(sort: Desc)], map: "warehouse_commands_actor_time_idx")
  @@map("warehouse_commands")
}

model WarehouseCommandOrder {
  commandId       String                    @map("command_id") @db.Uuid
  orderId         String                    @map("order_id") @db.Uuid
  eventId         String                    @unique(map: "warehouse_command_orders_event_key") @map("event_id") @db.Uuid
  beforeVersion   Int                       @map("before_version")
  afterVersion    Int                       @map("after_version")
  beforeStatus    SalesOrderStatus          @map("before_status")
  afterStatus     SalesOrderStatus          @map("after_status")
  pieceIds        String[]                  @map("piece_ids") @db.Uuid
  command         WarehouseCommand          @relation(fields: [commandId], references: [commandId], onDelete: Restrict, onUpdate: NoAction)
  order           SalesOrder                @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  receiptGroup    WarehouseReceiptGroup?
  attempt         WarehouseDeliveryAttempt?
  deliveryOutcome WarehouseDeliveryOutcome?
  deliveryRetry   WarehouseDeliveryRetry?

  @@id([commandId, orderId], map: "warehouse_command_orders_pkey")
  @@unique([orderId, afterVersion], map: "warehouse_command_orders_order_version_key")
  @@index([orderId, eventId], map: "warehouse_command_orders_order_event_idx")
  @@map("warehouse_command_orders")
}

model WarehouseReceiptGroup {
  id              String                  @id @db.Uuid
  commandId       String                  @map("command_id") @db.Uuid
  orderId         String                  @map("order_id") @db.Uuid
  cartonCount     String?                 @map("carton_count") @db.VarChar(4000)
  storageLocation String?                 @map("storage_location") @db.VarChar(4000)
  notes           String?                 @db.VarChar(4000)
  commandOrder    WarehouseCommandOrder   @relation(fields: [commandId, orderId], references: [commandId, orderId], onDelete: Restrict, onUpdate: NoAction)
  members         WarehouseReceiptPiece[]

  @@unique([commandId, orderId], map: "warehouse_receipt_groups_command_order_key")
  @@unique([id, orderId], map: "warehouse_receipt_groups_id_order_key")
  @@map("warehouse_receipt_groups")
}

model WarehouseReceiptPiece {
  pieceId        String                           @id @map("piece_id") @db.Uuid
  orderId        String                           @map("order_id") @db.Uuid
  origin         WarehouseReceiptOrigin
  groupId        String?                          @map("group_id") @db.Uuid
  qualityEventId String?                          @map("quality_event_id") @db.Uuid
  receivedAt     DateTime                         @map("received_at") @db.Timestamptz(6)
  piece          SalesOrderPiece                  @relation(fields: [pieceId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)
  group          WarehouseReceiptGroup?           @relation(fields: [groupId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)
  qualityEvent   QualityPieceEvent?               @relation(fields: [qualityEventId, orderId, pieceId], references: [id, orderId, pieceId], onDelete: Restrict, onUpdate: NoAction)
  attemptMembers WarehouseDeliveryAttemptMember[]

  @@unique([pieceId, orderId], map: "warehouse_receipt_pieces_piece_order_key")
  @@index([groupId, orderId], map: "warehouse_receipt_pieces_group_order_idx")
  @@index([qualityEventId, orderId, pieceId], map: "warehouse_receipt_pieces_quality_order_piece_idx")
  @@index([orderId, groupId, pieceId], map: "warehouse_receipt_pieces_order_group_piece_idx")
  @@map("warehouse_receipt_pieces")
}

enum WarehouseDeliveryOutcomeKind {
  DELIVERED
  FAILED

  @@map("warehouse_delivery_outcome_kind")
}

model WarehouseDeliveryAttempt {
  id                 String                           @id @db.Uuid
  orderId            String                           @map("order_id") @db.Uuid
  number             Int
  commandId          String                           @map("command_id") @db.Uuid
  deliveryNote       String?                          @map("delivery_note") @db.VarChar(4000)
  predecessorRetryId String?                          @unique(map: "warehouse_delivery_attempts_predecessor_retry_key") @map("predecessor_retry_id") @db.Uuid
  commandOrder       WarehouseCommandOrder            @relation(fields: [commandId, orderId], references: [commandId, orderId], onDelete: Restrict, onUpdate: NoAction)
  predecessorRetry   WarehouseDeliveryRetry?          @relation("WarehouseRetrySuccessor", fields: [predecessorRetryId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)
  members            WarehouseDeliveryAttemptMember[]
  outcome            WarehouseDeliveryOutcome?
  retry              WarehouseDeliveryRetry?

  @@unique([orderId, number], map: "warehouse_delivery_attempts_order_number_key")
  @@unique([id, orderId], map: "warehouse_delivery_attempts_id_order_key")
  @@unique([commandId, orderId], map: "warehouse_delivery_attempts_command_order_key")
  @@unique([predecessorRetryId, orderId], map: "warehouse_delivery_attempts_predecessor_order_key")
  @@index([orderId, number(sort: Desc)], map: "warehouse_delivery_attempts_order_number_idx")
  @@map("warehouse_delivery_attempts")
}

model WarehouseDeliveryAttemptMember {
  attemptId String                   @map("attempt_id") @db.Uuid
  orderId   String                   @map("order_id") @db.Uuid
  pieceId   String                   @map("piece_id") @db.Uuid
  attempt   WarehouseDeliveryAttempt @relation(fields: [attemptId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)
  receipt   WarehouseReceiptPiece    @relation(fields: [pieceId, orderId], references: [pieceId, orderId], onDelete: Restrict, onUpdate: NoAction)

  @@id([attemptId, pieceId], map: "warehouse_delivery_attempt_members_pkey")
  @@index([orderId, pieceId, attemptId], map: "warehouse_delivery_attempt_members_order_piece_attempt_idx")
  @@index([pieceId, orderId], map: "warehouse_delivery_attempt_members_piece_order_idx")
  @@map("warehouse_delivery_attempt_members")
}

model WarehouseDeliveryOutcome {
  id                  String                       @id @db.Uuid
  attemptId           String                       @unique(map: "warehouse_delivery_outcomes_attempt_key") @map("attempt_id") @db.Uuid
  orderId             String                       @map("order_id") @db.Uuid
  commandId           String                       @map("command_id") @db.Uuid
  kind                WarehouseDeliveryOutcomeKind
  recipient           String?                      @db.VarChar(4000)
  deliveredAt         DateTime?                    @map("delivered_at") @db.Timestamptz(6)
  reason              String?                      @db.VarChar(4000)
  notes               String?                      @db.VarChar(4000)
  returnedToWarehouse Boolean                      @map("returned_to_warehouse")
  attempt             WarehouseDeliveryAttempt     @relation(fields: [attemptId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)
  commandOrder        WarehouseCommandOrder        @relation(fields: [commandId, orderId], references: [commandId, orderId], onDelete: Restrict, onUpdate: NoAction)
  retries             WarehouseDeliveryRetry[]

  @@unique([id, orderId], map: "warehouse_delivery_outcomes_id_order_key")
  @@unique([attemptId, orderId], map: "warehouse_delivery_outcomes_attempt_order_key")
  @@unique([commandId, orderId], map: "warehouse_delivery_outcomes_command_order_key")
  @@map("warehouse_delivery_outcomes")
}

model WarehouseDeliveryRetry {
  id               String                    @id @db.Uuid
  attemptId        String                    @unique(map: "warehouse_delivery_retries_attempt_key") @map("attempt_id") @db.Uuid
  orderId          String                    @map("order_id") @db.Uuid
  outcomeId        String                    @map("outcome_id") @db.Uuid
  commandId        String                    @map("command_id") @db.Uuid
  retryDate        DateTime?                 @map("retry_date") @db.Date
  notes            String?                   @db.VarChar(4000)
  attempt          WarehouseDeliveryAttempt  @relation(fields: [attemptId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)
  outcome          WarehouseDeliveryOutcome  @relation(fields: [outcomeId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)
  commandOrder     WarehouseCommandOrder     @relation(fields: [commandId, orderId], references: [commandId, orderId], onDelete: Restrict, onUpdate: NoAction)
  successorAttempt WarehouseDeliveryAttempt? @relation("WarehouseRetrySuccessor")

  @@unique([id, orderId], map: "warehouse_delivery_retries_id_order_key")
  @@unique([attemptId, orderId], map: "warehouse_delivery_retries_attempt_order_key")
  @@unique([commandId, orderId], map: "warehouse_delivery_retries_command_order_key")
  @@index([outcomeId, orderId], map: "warehouse_delivery_retries_outcome_order_idx")
  @@map("warehouse_delivery_retries")
}

enum AdministrationOperation {
  ADMIN_CANCEL
  ADMIN_CORRECT

  @@map("administration_operation")
}

enum AdministrationCancellationScope {
  ORDER
  ITEM
  QUANTITY

  @@map("administration_cancellation_scope")
}

model AdministrationCommand {
  commandId                String                           @id(map: "administration_commands_pkey") @map("command_id") @db.Uuid
  operation                AdministrationOperation
  actorId                  String                           @map("actor_id") @db.Uuid
  actorFullName            String                           @map("actor_full_name") @db.VarChar(150)
  actorRole                UserRole                         @map("actor_role")
  actorDepartment          Department?                      @map("actor_department")
  orderId                  String                           @map("order_id") @db.Uuid
  expectedVersion          Int                              @map("expected_version")
  beforeVersion            Int                              @map("before_version")
  afterVersion             Int                              @map("after_version")
  payloadHash              String                           @map("payload_hash") @db.Char(64)
  reason                   String                           @db.VarChar(4000)
  scope                    AdministrationCancellationScope?
  pieceIds                 String[]                         @map("piece_ids") @db.Uuid
  beforeFacts              Json                             @map("before_facts") @db.JsonB
  afterFacts               Json                             @map("after_facts") @db.JsonB
  outcome                  Json                             @db.JsonB
  occurredAt               DateTime                         @map("occurred_at") @db.Timestamptz(6)
  actor                    User                             @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order                    SalesOrder                       @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  cancelledPieces          AdministrationCancelledPiece[]
  correction               AdministrationOrderCorrection?
  endedManufacturingVisits ManufacturingWorkVisit[]         @relation("ManufacturingVisitAdministrationEnd")
  endedQualityVisits       QualityWorkVisit[]               @relation("QualityVisitAdministrationEnd")
  resolvedQualityCycles    QualityCorrectionCycle[]         @relation("QualityCycleAdministrationResolution")
  resolvedIssues           ManufacturingIssue[]             @relation("IssueAdministrationResolution")

  @@unique([commandId, orderId], map: "administration_commands_command_order_key")
  @@unique([orderId, afterVersion], map: "administration_commands_order_version_key")
  @@index([orderId, occurredAt(sort: Desc), commandId(sort: Desc)], map: "administration_commands_order_time_id_idx")
  @@index([actorId, occurredAt(sort: Desc), commandId(sort: Desc)], map: "administration_commands_actor_time_id_idx")
  @@map("administration_commands")
}

model AdministrationCancelledPiece {
  commandId   String                @map("command_id") @db.Uuid
  orderId     String                @map("order_id") @db.Uuid
  pieceId     String                @unique(map: "administration_cancelled_pieces_piece_key") @map("piece_id") @db.Uuid
  beforeFacts Json                  @map("before_facts") @db.JsonB
  afterFacts  Json                  @map("after_facts") @db.JsonB
  command     AdministrationCommand @relation(fields: [commandId, orderId], references: [commandId, orderId], onDelete: Restrict, onUpdate: NoAction, map: "administration_cancelled_pieces_command_order_fkey")
  piece       SalesOrderPiece       @relation(fields: [pieceId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction, map: "administration_cancelled_pieces_piece_order_fkey")

  @@id([commandId, pieceId], map: "administration_cancelled_pieces_pkey")
  @@unique([pieceId, orderId], map: "administration_cancelled_pieces_piece_order_key")
  @@map("administration_cancelled_pieces")
}

model AdministrationOrderCorrection {
  commandId       String                @id(map: "administration_order_corrections_pkey") @map("command_id") @db.Uuid
  orderId         String                @map("order_id") @db.Uuid
  afterVersion    Int                   @map("after_version")
  customerName    String                @map("customer_name") @db.VarChar(150)
  customerPhone   String                @map("customer_phone") @db.VarChar(13)
  customerEmail   String?               @map("customer_email") @db.VarChar(320)
  customerAddress String?               @map("customer_address") @db.VarChar(2000)
  beforeValues    Json                  @map("before_values") @db.JsonB
  afterValues     Json                  @map("after_values") @db.JsonB
  changedFields   String[]              @map("changed_fields")
  command         AdministrationCommand @relation(fields: [commandId, orderId], references: [commandId, orderId], onDelete: Restrict, onUpdate: NoAction, map: "administration_order_corrections_command_order_fkey")
  order           SalesOrder            @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([commandId, orderId], map: "administration_order_corrections_command_order_key")
  @@unique([orderId, afterVersion], map: "administration_order_corrections_order_version_key")
  @@index([orderId, afterVersion(sort: Desc), commandId(sort: Desc)], map: "administration_order_corrections_order_version_idx")
  @@map("administration_order_corrections")
}
