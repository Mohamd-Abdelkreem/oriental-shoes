generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  PENDING_VERIFICATION
  PENDING_APPROVAL
  REJECTED
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum Department {
  SALES
  APPROVAL
  CUTTING
  PRODUCTION
  QUALITY
  WAREHOUSE

  @@map("department")
}

enum StaffOperation {
  APPROVE
  REJECT
  CHANGE_DEPARTMENT
  SUSPEND
  REACTIVATE

  @@map("staff_operation")
}

enum StaffDecisionAction {
  APPROVE
  RECONSIDER
  PREPARE_APPROVAL
  REJECT
  CHANGE_DEPARTMENT
  SUSPEND
  REACTIVATE

  @@map("staff_decision_action")
}

model User {
  id                         String      @id @default(uuid()) @db.Uuid
  email                      String      @unique @db.VarChar(320)
  passwordHash               String      @map("password_hash") @db.VarChar(255)
  fullName                   String      @map("full_name") @db.VarChar(150)
  phone                      String?     @db.VarChar(30)
  role                       UserRole    @default(USER)
  status                     UserStatus  @default(PENDING_VERIFICATION)
  emailVerifiedAt            DateTime?   @map("email_verified_at") @db.Timestamptz(6)
  verificationTokenHash      String?     @map("verification_token_hash") @db.Char(64)
  verificationTokenExpiresAt DateTime?   @map("verification_token_expires_at") @db.Timestamptz(6)
  resetTokenHash             String?     @map("reset_token_hash") @db.Char(64)
  resetTokenExpiresAt        DateTime?   @map("reset_token_expires_at") @db.Timestamptz(6)
  department                 Department? @map("department")
  staffApprovedAt            DateTime?   @map("staff_approved_at") @db.Timestamptz(6)
  staffApprovedById          String?     @map("staff_approved_by_id") @db.Uuid
  accessVersion              Int         @default(0) @map("access_version")
  createdAt                  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  submittedOrders SalesOrder[]
  salesDrafts     SalesDraft[]
  salesCommands   SalesCommand[]

  refreshTokens                    RefreshToken[]
  staffApprovedBy                  User?                             @relation("UserStaffApproval", fields: [staffApprovedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staffApprovalsGiven              User[]                            @relation("UserStaffApproval")
  staffApprovalDecisions           StaffDecision[]                   @relation("StaffDecisionTarget")
  staffActingDecisions             StaffDecision[]                   @relation("StaffDecisionActor")
  initialAdministratorProvisioning InitialAdministratorProvisioning? @relation("UserInitialAdministrator")
  approvalCommands                 ApprovalCommand[]
  manufacturingReports             ManufacturingIssue[]
  contactProposals                 PieceContactProposal[]
  manufacturingCommands            ManufacturingCommand[]

  @@index([status, role], map: "users_status_role_idx")
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "users_created_id_idx")
  @@index([role, status, createdAt(sort: Desc), id(sort: Desc)], map: "users_role_status_created_id_idx")
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_idx")
  @@index([expiresAt], map: "refresh_tokens_expiry_idx")
  @@map("refresh_tokens")
}

model StaffDecision {
  id                   String              @id @default(uuid()) @db.Uuid
  commandId            String              @unique @map("command_id") @db.Uuid
  targetId             String              @map("target_id") @db.Uuid
  actorId              String              @map("actor_id") @db.Uuid
  targetFullName       String              @map("target_full_name") @db.VarChar(150)
  targetEmail          String              @map("target_email") @db.VarChar(320)
  actorFullName        String              @map("actor_full_name") @db.VarChar(150)
  actorRole            UserRole            @map("actor_role")
  actorStatus          UserStatus          @map("actor_status")
  actorEmailVerifiedAt DateTime            @map("actor_email_verified_at") @db.Timestamptz(6)
  operation            StaffOperation      @map("operation")
  action               StaffDecisionAction @map("action")
  requestedDepartment  Department?         @map("requested_department")
  beforeVersion        Int                 @map("before_version")
  afterVersion         Int                 @map("after_version")
  beforeStatus         UserStatus          @map("before_status")
  afterStatus          UserStatus          @map("after_status")
  beforeDepartment     Department?         @map("before_department")
  afterDepartment      Department?         @map("after_department")
  beforeApprovedAt     DateTime?           @map("before_approved_at") @db.Timestamptz(6)
  afterApprovedAt      DateTime?           @map("after_approved_at") @db.Timestamptz(6)
  beforeApprovedById   String?             @map("before_approved_by_id") @db.Uuid
  afterApprovedById    String?             @map("after_approved_by_id") @db.Uuid
  occurredAt           DateTime            @map("occurred_at") @db.Timestamptz(6)

  target User @relation("StaffDecisionTarget", fields: [targetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor  User @relation("StaffDecisionActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([targetId, afterVersion], map: "staff_decisions_target_version_key")
  @@index([targetId, occurredAt(sort: Desc), id(sort: Desc)], map: "staff_decisions_target_occurred_id_idx")
  @@map("staff_decisions")
}

model InitialAdministratorProvisioning {
  id                String   @id @db.VarChar(13)
  targetId          String   @unique @map("target_id") @db.Uuid
  operatorReference String   @map("operator_reference") @db.VarChar(128)
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(6)
  beforeVersion     Int      @map("before_version")
  afterVersion      Int      @map("after_version")

  target User @relation("UserInitialAdministrator", fields: [targetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("initial_administrator_provisioning")
}

enum SalesOrderType {
  SHOP
  EXTERNAL
  REPAIR
  GIFT
  READY
  ACCESSORY
  ADJUSTMENT

  @@map("sales_order_type")
}

enum SalesDraftStatus {
  DRAFT
  SUBMITTED

  @@map("sales_draft_status")
}

enum SalesCommandOperation {
  CREATE_CUSTOMER
  UPDATE_CUSTOMER
  CREATE_DRAFT
  SAVE_DRAFT
  SUBMIT_NEW_ORDER
  SUBMIT_DRAFT
  RESUBMIT_ORDER
  SET_ORDER_PAID

  @@map("sales_command_operation")
}

model Customer {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @db.VarChar(150)
  phone     String         @unique(map: "customers_phone_key") @db.VarChar(13)
  email     String?        @db.VarChar(320)
  address   String?        @db.VarChar(2000)
  notes     String?        @db.VarChar(4000)
  version   Int            @default(1)
  createdAt DateTime       @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @map("updated_at") @db.Timestamptz(6)
  drafts    SalesDraft[]
  commands  SalesCommand[]

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "customers_created_id_idx")
  @@map("customers")
}

model SalesDraft {
  id                    String            @id @default(uuid()) @db.Uuid
  ownerId               String            @map("owner_id") @db.Uuid
  customerId            String?           @map("customer_id") @db.Uuid
  type                  SalesOrderType
  status                SalesDraftStatus  @default(DRAFT)
  deliveryDate          DateTime?         @map("delivery_date") @db.Date
  generalNotes          String?           @map("general_notes") @db.VarChar(4000)
  repairNote            String?           @map("repair_note") @db.VarChar(4000)
  adjustmentRequested   String?           @map("adjustment_requested") @db.VarChar(4000)
  adjustmentReason      String?           @map("adjustment_reason") @db.VarChar(4000)
  adjustmentActionTaken String?           @map("adjustment_action_taken") @db.VarChar(4000)
  responsibleSignature  String?           @map("responsible_signature") @db.VarChar(150)
  paidAmount            Decimal?          @map("paid_amount") @db.Decimal(11, 2)
  version               Int               @default(1)
  createdAt             DateTime          @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @map("updated_at") @db.Timestamptz(6)
  owner                 User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  customer              Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pieces                SalesDraftPiece[]
  commands              SalesCommand[]
  order                 SalesOrder?

  @@index([ownerId, updatedAt(sort: Desc), id(sort: Desc)], map: "sales_drafts_owner_updated_id_idx")
  @@index([customerId, ownerId, updatedAt(sort: Desc), id(sort: Desc)], map: "sales_drafts_customer_owner_updated_id_idx")
  @@index([updatedAt(sort: Desc), id(sort: Desc)], map: "sales_drafts_updated_id_idx")
  @@map("sales_drafts")
}

model SalesDraftPiece {
  id                String                       @id @db.Uuid
  draftId           String                       @map("draft_id") @db.Uuid
  position          Int
  quantity          Int                          @default(1)
  model             String?                      @map("model") @db.VarChar(200)
  size              String?                      @map("size") @db.VarChar(200)
  leatherBase       String?                      @map("leather_base") @db.VarChar(200)
  decoration        String?                      @map("decoration") @db.VarChar(200)
  decorationColor   String?                      @map("decoration_color") @db.VarChar(200)
  faceRight         String?                      @map("face_right") @db.VarChar(200)
  faceLeft          String?                      @map("face_left") @db.VarChar(200)
  mixing            String?                      @map("mixing") @db.VarChar(200)
  face              String?                      @map("face") @db.VarChar(200)
  sole              String?                      @map("sole") @db.VarChar(200)
  soleAddition      String?                      @map("sole_addition") @db.VarChar(200)
  soleColor         String?                      @map("sole_color") @db.VarChar(200)
  additions         String?                      @map("additions") @db.VarChar(200)
  aField            String?                      @map("a_field") @db.VarChar(200)
  fField            String?                      @map("f_field") @db.VarChar(200)
  sideNotes         String?                      @map("side_notes") @db.VarChar(4000)
  createdAt         DateTime                     @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                     @map("updated_at") @db.Timestamptz(6)
  removedAt         DateTime?                    @map("removed_at") @db.Timestamptz(6)
  draft             SalesDraft                   @relation(fields: [draftId], references: [id], onDelete: Restrict)
  orderPiece        SalesOrderPiece?
  catalogSelections SalesPieceCatalogSelection[]

  @@index([draftId, removedAt, position], map: "sales_draft_pieces_draft_removed_position_idx")
  @@map("sales_draft_pieces")
}

model SalesCommand {
  commandId       String                @id(map: "sales_commands_pkey") @map("command_id") @db.Uuid
  operation       SalesCommandOperation
  actorId         String                @map("actor_id") @db.Uuid
  actorFullName   String                @map("actor_full_name") @db.VarChar(150)
  actorRole       UserRole              @map("actor_role")
  actorDepartment Department?           @map("actor_department")
  requestTargetId String?               @map("request_target_id") @db.Uuid
  customerId      String?               @map("customer_id") @db.Uuid
  draftId         String?               @map("draft_id") @db.Uuid
  expectedVersion Int?                  @map("expected_version")
  beforeVersion   Int?                  @map("before_version")
  afterVersion    Int                   @map("after_version")
  payloadHash     String                @map("payload_hash") @db.Char(64)
  before          Json?                 @db.JsonB
  after           Json                  @db.JsonB
  occurredAt      DateTime              @map("occurred_at") @db.Timestamptz(6)
  actor           User                  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  customer        Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  draft           SalesDraft?           @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@index([draftId, occurredAt(sort: Desc), commandId(sort: Desc)], map: "sales_commands_draft_occurred_id_idx")
  @@index([actorId, occurredAt(sort: Desc), commandId(sort: Desc)], map: "sales_commands_actor_occurred_id_idx")
  @@map("sales_commands")
}

enum CatalogField {
  model
  size
  leatherBase
  decoration
  decorationColor
  sole
  soleAddition
  soleColor
  aField
  fField

  @@map("catalog_field")
}

enum SalesOrderStatus {
  AWAITING_APPROVAL
  RETURNED
  APPROVED
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERY_FAILED
  DELIVERED
  CANCELLED

  @@map("sales_order_status")
}

enum SalesPieceStage {
  AWAITING_APPROVAL
  CUTTING
  PRODUCTION
  QUALITY
  WAREHOUSE
  CANCELLED

  @@map("sales_piece_stage")
}

enum SalesPieceWorkState {
  INCOMING
  IN_PROGRESS
  COMPLETED
  BLOCKED

  @@map("sales_piece_work_state")
}

model CatalogSource {
  id                String              @id @default(uuid()) @db.Uuid
  sha256            String              @unique(map: "catalog_sources_sha256_key") @db.Char(64)
  worksheet         String              @db.VarChar(100)
  sourceExtent      String              @map("source_extent") @db.VarChar(32)
  mappingVersion    Int                 @map("mapping_version")
  loadedAt          DateTime            @map("loaded_at") @db.Timestamptz(6)
  loadedByReference String              @map("loaded_by_reference") @db.VarChar(128)
  entryCount        Int                 @map("entry_count")
  manifest          Json                @db.JsonB
  entries           CatalogEntry[]
  activations       CatalogActivation[]

  orders       SalesOrder[]
  pricedPieces SalesOrderPiece[]

  @@map("catalog_sources")
}

model CatalogEntry {
  id              String                       @id @default(uuid()) @db.Uuid
  sourceId        String                       @map("source_id") @db.Uuid
  kind            CatalogField
  sourceCell      String                       @map("source_cell") @db.VarChar(16)
  displayValue    String                       @map("display_value") @db.VarChar(200)
  lookupValue     String                       @map("lookup_value") @db.VarChar(200)
  familyCell      String?                      @map("family_cell") @db.VarChar(16)
  familyLabel     String?                      @map("family_label") @db.VarChar(200)
  position        Int
  unitPrice       Decimal?                     @map("unit_price") @db.Decimal
  priceSourceCell String?                      @map("price_source_cell") @db.VarChar(16)
  source          CatalogSource                @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  selections      SalesPieceCatalogSelection[]

  pricedPieces                 SalesOrderPiece[]
  beforeModelProposals         PieceContactProposal[] @relation("ProposalBeforeModel")
  beforeSizeProposals          PieceContactProposal[] @relation("ProposalBeforeSize")
  beforeLeatherBaseProposals   PieceContactProposal[] @relation("ProposalBeforeLeatherBase")
  beforeSoleProposals          PieceContactProposal[] @relation("ProposalBeforeSole")
  proposedModelProposals       PieceContactProposal[] @relation("ProposalProposedModel")
  proposedSizeProposals        PieceContactProposal[] @relation("ProposalProposedSize")
  proposedLeatherBaseProposals PieceContactProposal[] @relation("ProposalProposedLeatherBase")
  proposedSoleProposals        PieceContactProposal[] @relation("ProposalProposedSole")

  @@unique([sourceId, kind, sourceCell], map: "catalog_entries_source_kind_cell_key")
  @@unique([id, sourceId], map: "catalog_entries_id_source_key")
  @@index([sourceId, kind, familyCell, position, id], map: "catalog_entries_source_kind_family_position_idx")
  @@index([sourceId, kind, lookupValue], map: "catalog_entries_source_kind_lookup_idx")
  @@map("catalog_entries")
}

model CatalogActivation {
  id          String         @id @db.VarChar(6)
  sourceId    String?        @map("source_id") @db.Uuid
  activatedAt DateTime?      @map("activated_at") @db.Timestamptz(6)
  source      CatalogSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@map("catalog_activation")
}

model SalesPieceCatalogSelection {
  pieceId String          @map("piece_id") @db.Uuid
  field   CatalogField
  entryId String          @map("entry_id") @db.Uuid
  piece   SalesDraftPiece @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  entry   CatalogEntry    @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@id([pieceId, field], map: "sales_piece_catalog_selections_pkey")
  @@index([entryId], map: "sales_piece_catalog_selections_entry_idx")
  @@map("sales_piece_catalog_selections")
}

model SalesOrder {
  id                         String                      @id @db.Uuid
  status                     SalesOrderStatus            @default(AWAITING_APPROVAL)
  businessNumber             String                      @unique(map: "sales_orders_business_number_key") @map("business_number") @db.VarChar(64)
  numberSequence             BigInt                      @unique(map: "sales_orders_number_sequence_key") @map("number_sequence")
  numberYear                 Int                         @map("number_year")
  submittedAt                DateTime                    @map("submitted_at") @db.Timestamptz(6)
  submittedById              String                      @map("submitted_by_id") @db.Uuid
  ownerFullNameAtSubmission  String                      @map("owner_full_name_at_submission") @db.VarChar(150)
  customerName               String                      @map("customer_name") @db.VarChar(150)
  customerPhone              String                      @map("customer_phone") @db.VarChar(13)
  customerEmail              String?                     @map("customer_email") @db.VarChar(320)
  customerAddress            String?                     @map("customer_address") @db.VarChar(2000)
  catalogSourceId            String                      @map("catalog_source_id") @db.Uuid
  totalAmount                Decimal                     @map("total_amount") @db.Decimal
  paidAmount                 Decimal                     @map("paid_amount") @db.Decimal
  approvedAt                 DateTime?                   @map("approved_at") @db.Timestamptz(6)
  currentReturnDecisionId    String?                     @map("current_return_decision_id") @db.Uuid
  currentReturnOrderVersion  Int?                        @map("current_return_order_version")
  currentReturnReason        String?                     @map("current_return_reason") @db.VarChar(4000)
  currentReturnedAt          DateTime?                   @map("current_returned_at") @db.Timestamptz(6)
  draft                      SalesDraft                  @relation(fields: [id], references: [id], onDelete: Restrict)
  submittedBy                User                        @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  catalogSource              CatalogSource               @relation(fields: [catalogSourceId], references: [id], onDelete: Restrict)
  pieces                     SalesOrderPiece[]
  approvalCommands           ApprovalCommand[]
  manufacturingIssues        ManufacturingIssue[]
  contactProposals           PieceContactProposal[]
  manufacturingCommandOrders ManufacturingCommandOrder[]

  @@index([status, submittedAt(sort: Desc), id(sort: Desc)], map: "sales_orders_status_submitted_id_idx")
  @@map("sales_orders")
}

model SalesOrderPiece {
  id                  String               @id @db.Uuid
  orderId             String               @map("order_id") @db.Uuid
  decorationEntryId   String               @map("decoration_entry_id") @db.Uuid
  priceSourceId       String               @map("price_source_id") @db.Uuid
  decorationLabel     String               @map("decoration_label") @db.VarChar(200)
  unitPrice           Decimal              @map("unit_price") @db.Decimal
  priceSourceCell     String               @map("price_source_cell") @db.VarChar(16)
  stage               SalesPieceStage      @default(AWAITING_APPROVAL)
  workState           SalesPieceWorkState  @default(INCOMING) @map("work_state")
  issueId             String?              @map("issue_id") @db.Uuid
  receivedAt          DateTime?            @map("received_at") @db.Timestamptz(6)
  cancelledAt         DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason  String?              @map("cancellation_reason") @db.VarChar(4000)
  piece               SalesDraftPiece      @relation(fields: [id], references: [id], onDelete: Restrict)
  order               SalesOrder           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  decorationEntry     CatalogEntry         @relation(fields: [decorationEntryId, priceSourceId], references: [id, sourceId], onDelete: Restrict, map: "sales_order_pieces_decoration_source_fkey")
  priceSource         CatalogSource        @relation(fields: [priceSourceId], references: [id], onDelete: Restrict)
  manufacturingIssues ManufacturingIssue[] @relation("IssuePiece")
  currentIssue        ManufacturingIssue?  @relation("CurrentIssue", fields: [issueId, orderId, id], references: [id, orderId, pieceId], onDelete: Restrict, onUpdate: NoAction, map: "sales_order_pieces_current_issue_fkey")

  currentWorkVisitId String?                  @map("current_work_visit_id") @db.Uuid
  currentWorkVisit   ManufacturingWorkVisit?  @relation("CurrentWorkVisit", fields: [currentWorkVisitId, orderId, id], references: [id, orderId, pieceId], onDelete: Restrict, onUpdate: NoAction, map: "sales_order_pieces_current_work_visit_fkey")
  workVisits         ManufacturingWorkVisit[] @relation("VisitPiece")

  @@unique([id, orderId], map: "sales_order_pieces_id_order_key")
  @@index([stage, workState, id], map: "sales_order_pieces_department_state_id_idx")
  @@index([orderId, stage, receivedAt, id], map: "sales_order_pieces_order_stage_received_idx")
  @@map("sales_order_pieces")
}

model BusinessOrderCounter {
  id         String @id @db.VarChar(6)
  lastIssued BigInt @default(0) @map("last_issued")

  @@map("business_order_counter")
}

enum ApprovalCommandOperation {
  APPROVE_INITIAL
  RETURN_INITIAL
  REPORT_ISSUE
  RESOLVE_ISSUE
  SUBMIT_CONTACT
  REVIEW_CONTACT

  @@map("approval_command_operation")
}

enum ManufacturingIssueState {
  APPROVAL_REVIEW
  SALES_CONTACT
  REAPPROVAL
  RESOLVED

  @@map("manufacturing_issue_state")
}

enum PieceContactKind {
  AMEND
  CANCEL_REQUEST

  @@map("piece_contact_kind")
}

model ApprovalCommand {
  commandId         String                   @id(map: "approval_commands_pkey") @map("command_id") @db.Uuid
  operation         ApprovalCommandOperation
  actorId           String                   @map("actor_id") @db.Uuid
  actorFullName     String                   @map("actor_full_name") @db.VarChar(150)
  actorRole         UserRole                 @map("actor_role")
  actorDepartment   Department?              @map("actor_department")
  orderId           String                   @map("order_id") @db.Uuid
  pieceId           String?                  @map("piece_id") @db.Uuid
  issueId           String?                  @map("issue_id") @db.Uuid
  proposalId        String?                  @map("proposal_id") @db.Uuid
  expectedVersion   Int                      @map("expected_version")
  beforeVersion     Int                      @map("before_version")
  afterVersion      Int                      @map("after_version")
  payloadHash       String                   @map("payload_hash") @db.Char(64)
  decision          String?                  @db.VarChar(32)
  decisionNotes     String?                  @map("decision_notes") @db.VarChar(4000)
  beforeFacts       Json                     @map("before_facts") @db.JsonB
  afterFacts        Json                     @map("after_facts") @db.JsonB
  outcome           Json                     @db.JsonB
  occurredAt        DateTime                 @map("occurred_at") @db.Timestamptz(6)
  actor             User                     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  order             SalesOrder               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  issue             ManufacturingIssue?      @relation("CommandIssue", fields: [issueId, orderId, pieceId], references: [id, orderId, pieceId], onDelete: Restrict, onUpdate: NoAction, map: "approval_commands_issue_fkey")
  proposal          PieceContactProposal?    @relation("CommandProposal", fields: [proposalId, issueId], references: [id, issueId], onDelete: Restrict, onUpdate: NoAction, map: "approval_commands_proposal_fkey")
  reportedIssue     ManufacturingIssue?      @relation("IssueReportedCommand")
  resolvedIssues    ManufacturingIssue[]     @relation("IssueResolutionCommand")
  submittedProposal PieceContactProposal?    @relation("ProposalSubmittedCommand")

  sourcedWorkVisits ManufacturingWorkVisit[] @relation("VisitApprovalSource")
  endedWorkVisits   ManufacturingWorkVisit[] @relation("VisitApprovalEnd")

  @@unique([orderId, afterVersion], map: "approval_commands_order_version_key")
  @@index([actorId, occurredAt(sort: Desc), commandId(sort: Desc)], map: "approval_commands_actor_occurred_id_idx")
  @@index([orderId, occurredAt(sort: Desc), commandId(sort: Desc)], map: "approval_commands_order_occurred_id_idx")
  @@index([operation, occurredAt(sort: Desc), commandId(sort: Desc)], map: "approval_commands_operation_occurred_idx")
  @@index([issueId, afterVersion(sort: Desc)], map: "approval_commands_issue_version_idx")
  @@map("approval_commands")
}

model ManufacturingIssue {
  id                  String                  @id @default(uuid()) @db.Uuid
  orderId             String                  @map("order_id") @db.Uuid
  pieceId             String                  @map("piece_id") @db.Uuid
  cycle               Int
  state               ManufacturingIssueState
  sourceDepartment    Department              @map("source_department")
  sourceStage         SalesPieceStage         @map("source_stage")
  sourceWorkState     SalesPieceWorkState     @map("source_work_state")
  reporterId          String                  @map("reporter_id") @db.Uuid
  reporterFullName    String                  @map("reporter_full_name") @db.VarChar(150)
  reporterRole        UserRole                @map("reporter_role")
  reporterDepartment  Department?             @map("reporter_department")
  reason              String                  @db.VarChar(4000)
  notes               String?                 @db.VarChar(4000)
  reportedAt          DateTime                @map("reported_at") @db.Timestamptz(6)
  updatedAt           DateTime                @map("updated_at") @db.Timestamptz(6)
  reportedCommandId   String                  @unique(map: "manufacturing_issues_reported_command_key") @map("reported_command_id") @db.Uuid
  resumeTarget        SalesPieceStage?        @map("resume_target")
  latestProposalId    String?                 @map("latest_proposal_id") @db.Uuid
  resolvedAt          DateTime?               @map("resolved_at") @db.Timestamptz(6)
  resolutionCommandId String?                 @map("resolution_command_id") @db.Uuid
  order               SalesOrder              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  piece               SalesOrderPiece         @relation("IssuePiece", fields: [pieceId, orderId], references: [id, orderId], onDelete: Restrict)
  reporter            User                    @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  reportedCommand     ApprovalCommand         @relation("IssueReportedCommand", fields: [reportedCommandId], references: [commandId], onDelete: Restrict, onUpdate: NoAction, map: "manufacturing_issues_reported_command_fkey")
  resolutionCommand   ApprovalCommand?        @relation("IssueResolutionCommand", fields: [resolutionCommandId], references: [commandId], onDelete: Restrict, onUpdate: NoAction, map: "manufacturing_issues_resolution_command_fkey")
  latestProposal      PieceContactProposal?   @relation("IssueLatestProposal", fields: [latestProposalId, id], references: [id, issueId], onDelete: Restrict, onUpdate: NoAction, map: "manufacturing_issues_latest_proposal_fkey")
  proposals           PieceContactProposal[]  @relation("ProposalIssue")
  currentPieces       SalesOrderPiece[]       @relation("CurrentIssue")
  commands            ApprovalCommand[]       @relation("CommandIssue")

  sourcedWorkVisits ManufacturingWorkVisit[] @relation("VisitIssueSource")

  @@unique([pieceId, cycle], map: "manufacturing_issues_piece_cycle_key")
  @@unique([id, orderId, pieceId], map: "manufacturing_issues_id_order_piece_key")
  @@index([state, reportedAt(sort: Desc), id(sort: Desc)], map: "manufacturing_issues_state_reported_id_idx")
  @@index([orderId, pieceId, cycle], map: "manufacturing_issues_order_piece_cycle_idx")
  @@map("manufacturing_issues")
}

model PieceContactProposal {
  id                       String               @id @default(uuid()) @db.Uuid
  orderId                  String               @map("order_id") @db.Uuid
  pieceId                  String               @map("piece_id") @db.Uuid
  issueId                  String               @map("issue_id") @db.Uuid
  sequence                 Int
  kind                     PieceContactKind
  submittedCommandId       String               @unique(map: "piece_contact_proposals_submitted_command_key") @map("submitted_command_id") @db.Uuid
  submittedById            String               @map("submitted_by_id") @db.Uuid
  submittedByFullName      String               @map("submitted_by_full_name") @db.VarChar(150)
  contactNotes             String               @map("contact_notes") @db.VarChar(4000)
  submittedAt              DateTime             @map("submitted_at") @db.Timestamptz(6)
  order                    SalesOrder           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  issue                    ManufacturingIssue   @relation("ProposalIssue", fields: [issueId, orderId, pieceId], references: [id, orderId, pieceId], onDelete: Restrict)
  submittedBy              User                 @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  submittedCommand         ApprovalCommand      @relation("ProposalSubmittedCommand", fields: [submittedCommandId], references: [commandId], onDelete: Restrict, onUpdate: NoAction, map: "piece_contact_proposals_submitted_command_fkey")
  latestForIssues          ManufacturingIssue[] @relation("IssueLatestProposal")
  commands                 ApprovalCommand[]    @relation("CommandProposal")
  beforeModel              String               @map("before_model") @db.VarChar(200)
  beforeModelId            String?              @map("before_model_id") @db.Uuid
  beforeModelEntry         CatalogEntry?        @relation("ProposalBeforeModel", fields: [beforeModelId], references: [id], onDelete: Restrict)
  beforeSize               String               @map("before_size") @db.VarChar(200)
  beforeSizeId             String?              @map("before_size_id") @db.Uuid
  beforeSizeEntry          CatalogEntry?        @relation("ProposalBeforeSize", fields: [beforeSizeId], references: [id], onDelete: Restrict)
  beforeLeatherBase        String               @map("before_leather_base") @db.VarChar(200)
  beforeLeatherBaseId      String?              @map("before_leather_base_id") @db.Uuid
  beforeLeatherBaseEntry   CatalogEntry?        @relation("ProposalBeforeLeatherBase", fields: [beforeLeatherBaseId], references: [id], onDelete: Restrict)
  beforeSole               String?              @map("before_sole") @db.VarChar(200)
  beforeSoleId             String?              @map("before_sole_id") @db.Uuid
  beforeSoleEntry          CatalogEntry?        @relation("ProposalBeforeSole", fields: [beforeSoleId], references: [id], onDelete: Restrict)
  proposedModel            String?              @map("proposed_model") @db.VarChar(200)
  proposedModelId          String?              @map("proposed_model_id") @db.Uuid
  proposedModelEntry       CatalogEntry?        @relation("ProposalProposedModel", fields: [proposedModelId], references: [id], onDelete: Restrict)
  proposedSize             String?              @map("proposed_size") @db.VarChar(200)
  proposedSizeId           String?              @map("proposed_size_id") @db.Uuid
  proposedSizeEntry        CatalogEntry?        @relation("ProposalProposedSize", fields: [proposedSizeId], references: [id], onDelete: Restrict)
  proposedLeatherBase      String?              @map("proposed_leather_base") @db.VarChar(200)
  proposedLeatherBaseId    String?              @map("proposed_leather_base_id") @db.Uuid
  proposedLeatherBaseEntry CatalogEntry?        @relation("ProposalProposedLeatherBase", fields: [proposedLeatherBaseId], references: [id], onDelete: Restrict)
  proposedSole             String?              @map("proposed_sole") @db.VarChar(200)
  proposedSoleId           String?              @map("proposed_sole_id") @db.Uuid
  proposedSoleEntry        CatalogEntry?        @relation("ProposalProposedSole", fields: [proposedSoleId], references: [id], onDelete: Restrict)

  @@unique([issueId, sequence], map: "piece_contact_proposals_issue_sequence_key")
  @@unique([id, issueId], map: "piece_contact_proposals_id_issue_key")
  @@index([issueId, sequence(sort: Desc)], map: "piece_contact_proposals_issue_sequence_idx")
  @@map("piece_contact_proposals")
}

enum ManufacturingOperation {
  RECEIVE_AND_START
  CONTINUE
  COMPLETE_TRANSFER

  @@map("manufacturing_operation")
}

enum ManufacturingVisitOriginKind {
  INITIAL_APPROVAL
  APPROVAL_RETURN
  DEPARTMENT_TRANSFER
  QUALITY_CORRECTION
  LEGACY_BASELINE

  @@map("manufacturing_visit_origin_kind")
}

enum ManufacturingVisitEndReason {
  TRANSFERRED
  ISSUE_REPORTED
  CANCELLED

  @@map("manufacturing_visit_end_reason")
}

model ManufacturingCommand {
  commandId       String                      @id(map: "manufacturing_commands_pkey") @map("command_id") @db.Uuid
  operation       ManufacturingOperation
  department      Department
  actorId         String                      @map("actor_id") @db.Uuid
  actorFullName   String                      @map("actor_full_name") @db.VarChar(150)
  actorRole       UserRole                    @map("actor_role")
  actorDepartment Department?                 @map("actor_department")
  payloadHash     String                      @map("payload_hash") @db.Char(64)
  outcome         Json                        @db.JsonB
  occurredAt      DateTime                    @map("occurred_at") @db.Timestamptz(6)
  actor           User                        @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orders          ManufacturingCommandOrder[]
  receivedVisits  ManufacturingWorkVisit[]    @relation("VisitReceivedCommand")
  startedVisits   ManufacturingWorkVisit[]    @relation("VisitStartedCommand")
  endedVisits     ManufacturingWorkVisit[]    @relation("VisitManufacturingEnd")

  @@index([actorId, department, occurredAt(sort: Desc), commandId(sort: Desc)], map: "manufacturing_commands_actor_dept_time_idx")
  @@map("manufacturing_commands")
}

model ManufacturingCommandOrder {
  commandId     String                    @map("command_id") @db.Uuid
  orderId       String                    @map("order_id") @db.Uuid
  eventId       String                    @unique(map: "manufacturing_command_orders_event_key") @map("event_id") @db.Uuid
  beforeVersion Int                       @map("before_version")
  afterVersion  Int                       @map("after_version")
  pieceIds      String[]                  @map("piece_ids") @db.Uuid
  command       ManufacturingCommand      @relation(fields: [commandId], references: [commandId], onDelete: Restrict, onUpdate: NoAction)
  order         SalesOrder                @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  events        ManufacturingPieceEvent[]

  @@id([commandId, orderId], map: "manufacturing_command_orders_pkey")
  @@unique([orderId, afterVersion], map: "manufacturing_command_orders_order_version_key")
  @@index([orderId, eventId], map: "manufacturing_command_orders_order_event_idx")
  @@map("manufacturing_command_orders")
}

model ManufacturingWorkVisit {
  id                        String                       @id @default(uuid()) @db.Uuid
  orderId                   String                       @map("order_id") @db.Uuid
  pieceId                   String                       @map("piece_id") @db.Uuid
  department                Department
  sequence                  Int
  originKind                ManufacturingVisitOriginKind @map("origin_kind")
  sourceDepartment          Department?                  @map("source_department")
  sourceApprovalCommandId   String?                      @map("source_approval_command_id") @db.Uuid
  sourceTransferEventId     String?                      @map("source_transfer_event_id") @db.Uuid
  sourceIssueId             String?                      @map("source_issue_id") @db.Uuid
  sourceReferenceId         String?                      @map("source_reference_id") @db.Uuid
  sourceCorrectionCycle     Int?                         @map("source_correction_cycle")
  sourceOrderVersion        Int?                         @map("source_order_version")
  instructions              String?                      @db.VarChar(4000)
  enteredAt                 DateTime?                    @map("entered_at") @db.Timestamptz(6)
  receivedAt                DateTime?                    @map("received_at") @db.Timestamptz(6)
  receivedCommandId         String?                      @map("received_command_id") @db.Uuid
  startedAt                 DateTime?                    @map("started_at") @db.Timestamptz(6)
  startedCommandId          String?                      @map("started_command_id") @db.Uuid
  endedAt                   DateTime?                    @map("ended_at") @db.Timestamptz(6)
  endReason                 ManufacturingVisitEndReason? @map("end_reason")
  endManufacturingCommandId String?                      @map("end_manufacturing_command_id") @db.Uuid
  endApprovalCommandId      String?                      @map("end_approval_command_id") @db.Uuid
  destination               Department?
  legacyUnknownStart        Boolean                      @default(false) @map("legacy_unknown_start")
  piece                     SalesOrderPiece              @relation("VisitPiece", fields: [pieceId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)
  currentPieces             SalesOrderPiece[]            @relation("CurrentWorkVisit")
  sourceApprovalCommand     ApprovalCommand?             @relation("VisitApprovalSource", fields: [sourceApprovalCommandId], references: [commandId], onDelete: Restrict, onUpdate: NoAction)
  sourceTransferEvent       ManufacturingPieceEvent?     @relation("VisitTransferSource", fields: [sourceTransferEventId, orderId, pieceId], references: [id, orderId, pieceId], onDelete: Restrict, onUpdate: NoAction, map: "manufacturing_work_visits_source_transfer_fkey")
  sourceIssue               ManufacturingIssue?          @relation("VisitIssueSource", fields: [sourceIssueId, orderId, pieceId], references: [id, orderId, pieceId], onDelete: Restrict, onUpdate: NoAction, map: "manufacturing_work_visits_source_issue_fkey")
  receivedCommand           ManufacturingCommand?        @relation("VisitReceivedCommand", fields: [receivedCommandId], references: [commandId], onDelete: Restrict, onUpdate: NoAction)
  startedCommand            ManufacturingCommand?        @relation("VisitStartedCommand", fields: [startedCommandId], references: [commandId], onDelete: Restrict, onUpdate: NoAction)
  endManufacturingCommand   ManufacturingCommand?        @relation("VisitManufacturingEnd", fields: [endManufacturingCommandId], references: [commandId], onDelete: Restrict, onUpdate: NoAction)
  endApprovalCommand        ApprovalCommand?             @relation("VisitApprovalEnd", fields: [endApprovalCommandId], references: [commandId], onDelete: Restrict, onUpdate: NoAction)
  events                    ManufacturingPieceEvent[]    @relation("EventVisit")

  @@unique([id, orderId, pieceId], map: "manufacturing_work_visits_id_order_piece_key")
  @@unique([pieceId, sequence], map: "manufacturing_work_visits_piece_sequence_key")
  @@index([department, pieceId, sequence(sort: Desc)], map: "manufacturing_work_visits_dept_piece_sequence_idx")
  @@index([orderId, pieceId, sequence(sort: Desc)], map: "manufacturing_work_visits_order_piece_sequence_idx")
  @@map("manufacturing_work_visits")
}

model ManufacturingPieceEvent {
  id              String                    @id @default(uuid()) @db.Uuid
  commandId       String                    @map("command_id") @db.Uuid
  orderId         String                    @map("order_id") @db.Uuid
  pieceId         String                    @map("piece_id") @db.Uuid
  visitId         String                    @map("visit_id") @db.Uuid
  operation       ManufacturingOperation
  beforeStage     SalesPieceStage           @map("before_stage")
  beforeWorkState SalesPieceWorkState       @map("before_work_state")
  afterStage      SalesPieceStage           @map("after_stage")
  afterWorkState  SalesPieceWorkState       @map("after_work_state")
  commandOrder    ManufacturingCommandOrder @relation(fields: [commandId, orderId], references: [commandId, orderId], onDelete: Restrict, onUpdate: NoAction)
  visit           ManufacturingWorkVisit    @relation("EventVisit", fields: [visitId, orderId, pieceId], references: [id, orderId, pieceId], onDelete: Restrict, onUpdate: NoAction, map: "manufacturing_piece_events_visit_fkey")
  sourcedVisits   ManufacturingWorkVisit[]  @relation("VisitTransferSource")

  @@unique([id, orderId, pieceId], map: "manufacturing_piece_events_id_order_piece_key")
  @@unique([commandId, pieceId], map: "manufacturing_piece_events_command_piece_key")
  @@index([visitId, commandId], map: "manufacturing_piece_events_visit_command_idx")
  @@map("manufacturing_piece_events")
}
