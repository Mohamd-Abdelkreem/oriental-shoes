generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  PENDING_VERIFICATION
  PENDING_APPROVAL
  REJECTED
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum Department {
  SALES
  APPROVAL
  CUTTING
  PRODUCTION
  QUALITY
  WAREHOUSE

  @@map("department")
}

enum StaffOperation {
  APPROVE
  REJECT
  CHANGE_DEPARTMENT
  SUSPEND
  REACTIVATE

  @@map("staff_operation")
}

enum StaffDecisionAction {
  APPROVE
  RECONSIDER
  PREPARE_APPROVAL
  REJECT
  CHANGE_DEPARTMENT
  SUSPEND
  REACTIVATE

  @@map("staff_decision_action")
}

model User {
  id                         String      @id @default(uuid()) @db.Uuid
  email                      String      @unique @db.VarChar(320)
  passwordHash               String      @map("password_hash") @db.VarChar(255)
  fullName                   String      @map("full_name") @db.VarChar(150)
  phone                      String?     @db.VarChar(30)
  role                       UserRole    @default(USER)
  status                     UserStatus  @default(PENDING_VERIFICATION)
  emailVerifiedAt            DateTime?   @map("email_verified_at") @db.Timestamptz(6)
  verificationTokenHash      String?     @map("verification_token_hash") @db.Char(64)
  verificationTokenExpiresAt DateTime?   @map("verification_token_expires_at") @db.Timestamptz(6)
  resetTokenHash             String?     @map("reset_token_hash") @db.Char(64)
  resetTokenExpiresAt        DateTime?   @map("reset_token_expires_at") @db.Timestamptz(6)
  department                 Department? @map("department")
  staffApprovedAt            DateTime?   @map("staff_approved_at") @db.Timestamptz(6)
  staffApprovedById          String?     @map("staff_approved_by_id") @db.Uuid
  accessVersion              Int         @default(0) @map("access_version")
  createdAt                  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  salesDrafts   SalesDraft[]
  salesCommands SalesCommand[]

  refreshTokens                    RefreshToken[]
  staffApprovedBy                  User?                             @relation("UserStaffApproval", fields: [staffApprovedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staffApprovalsGiven              User[]                            @relation("UserStaffApproval")
  staffApprovalDecisions           StaffDecision[]                   @relation("StaffDecisionTarget")
  staffActingDecisions             StaffDecision[]                   @relation("StaffDecisionActor")
  initialAdministratorProvisioning InitialAdministratorProvisioning? @relation("UserInitialAdministrator")

  @@index([status, role], map: "users_status_role_idx")
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "users_created_id_idx")
  @@index([role, status, createdAt(sort: Desc), id(sort: Desc)], map: "users_role_status_created_id_idx")
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_idx")
  @@index([expiresAt], map: "refresh_tokens_expiry_idx")
  @@map("refresh_tokens")
}

model StaffDecision {
  id                   String              @id @default(uuid()) @db.Uuid
  commandId            String              @unique @map("command_id") @db.Uuid
  targetId             String              @map("target_id") @db.Uuid
  actorId              String              @map("actor_id") @db.Uuid
  targetFullName       String              @map("target_full_name") @db.VarChar(150)
  targetEmail          String              @map("target_email") @db.VarChar(320)
  actorFullName        String              @map("actor_full_name") @db.VarChar(150)
  actorRole            UserRole            @map("actor_role")
  actorStatus          UserStatus          @map("actor_status")
  actorEmailVerifiedAt DateTime            @map("actor_email_verified_at") @db.Timestamptz(6)
  operation            StaffOperation      @map("operation")
  action               StaffDecisionAction @map("action")
  requestedDepartment  Department?         @map("requested_department")
  beforeVersion        Int                 @map("before_version")
  afterVersion         Int                 @map("after_version")
  beforeStatus         UserStatus          @map("before_status")
  afterStatus          UserStatus          @map("after_status")
  beforeDepartment     Department?         @map("before_department")
  afterDepartment      Department?         @map("after_department")
  beforeApprovedAt     DateTime?           @map("before_approved_at") @db.Timestamptz(6)
  afterApprovedAt      DateTime?           @map("after_approved_at") @db.Timestamptz(6)
  beforeApprovedById   String?             @map("before_approved_by_id") @db.Uuid
  afterApprovedById    String?             @map("after_approved_by_id") @db.Uuid
  occurredAt           DateTime            @map("occurred_at") @db.Timestamptz(6)

  target User @relation("StaffDecisionTarget", fields: [targetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor  User @relation("StaffDecisionActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([targetId, afterVersion], map: "staff_decisions_target_version_key")
  @@index([targetId, occurredAt(sort: Desc), id(sort: Desc)], map: "staff_decisions_target_occurred_id_idx")
  @@map("staff_decisions")
}

model InitialAdministratorProvisioning {
  id                String   @id @db.VarChar(13)
  targetId          String   @unique @map("target_id") @db.Uuid
  operatorReference String   @map("operator_reference") @db.VarChar(128)
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(6)
  beforeVersion     Int      @map("before_version")
  afterVersion      Int      @map("after_version")

  target User @relation("UserInitialAdministrator", fields: [targetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("initial_administrator_provisioning")
}

enum SalesOrderType {
  SHOP
  EXTERNAL
  REPAIR
  GIFT
  READY
  ACCESSORY
  ADJUSTMENT

  @@map("sales_order_type")
}

enum SalesDraftStatus {
  DRAFT

  @@map("sales_draft_status")
}

enum SalesCommandOperation {
  CREATE_CUSTOMER
  UPDATE_CUSTOMER
  CREATE_DRAFT
  SAVE_DRAFT

  @@map("sales_command_operation")
}

model Customer {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @db.VarChar(150)
  phone     String         @unique(map: "customers_phone_key") @db.VarChar(13)
  email     String?        @db.VarChar(320)
  address   String?        @db.VarChar(2000)
  notes     String?        @db.VarChar(4000)
  version   Int            @default(1)
  createdAt DateTime       @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @map("updated_at") @db.Timestamptz(6)
  drafts    SalesDraft[]
  commands  SalesCommand[]

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "customers_created_id_idx")
  @@map("customers")
}

model SalesDraft {
  id                    String            @id @default(uuid()) @db.Uuid
  ownerId               String            @map("owner_id") @db.Uuid
  customerId            String?           @map("customer_id") @db.Uuid
  type                  SalesOrderType
  status                SalesDraftStatus  @default(DRAFT)
  deliveryDate          DateTime?         @map("delivery_date") @db.Date
  generalNotes          String?           @map("general_notes") @db.VarChar(4000)
  repairNote            String?           @map("repair_note") @db.VarChar(4000)
  adjustmentRequested   String?           @map("adjustment_requested") @db.VarChar(4000)
  adjustmentReason      String?           @map("adjustment_reason") @db.VarChar(4000)
  adjustmentActionTaken String?           @map("adjustment_action_taken") @db.VarChar(4000)
  responsibleSignature  String?           @map("responsible_signature") @db.VarChar(150)
  paidAmount            Decimal?          @map("paid_amount") @db.Decimal(11, 2)
  version               Int               @default(1)
  createdAt             DateTime          @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @map("updated_at") @db.Timestamptz(6)
  owner                 User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  customer              Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pieces                SalesDraftPiece[]
  commands              SalesCommand[]

  @@index([ownerId, updatedAt(sort: Desc), id(sort: Desc)], map: "sales_drafts_owner_updated_id_idx")
  @@index([customerId, ownerId, updatedAt(sort: Desc), id(sort: Desc)], map: "sales_drafts_customer_owner_updated_id_idx")
  @@index([updatedAt(sort: Desc), id(sort: Desc)], map: "sales_drafts_updated_id_idx")
  @@map("sales_drafts")
}

model SalesDraftPiece {
  id              String     @id @db.Uuid
  draftId         String     @map("draft_id") @db.Uuid
  position        Int
  quantity        Int        @default(1)
  model           String?    @map("model") @db.VarChar(200)
  size            String?    @map("size") @db.VarChar(200)
  leatherBase     String?    @map("leather_base") @db.VarChar(200)
  decoration      String?    @map("decoration") @db.VarChar(200)
  decorationColor String?    @map("decoration_color") @db.VarChar(200)
  faceRight       String?    @map("face_right") @db.VarChar(200)
  faceLeft        String?    @map("face_left") @db.VarChar(200)
  mixing          String?    @map("mixing") @db.VarChar(200)
  face            String?    @map("face") @db.VarChar(200)
  sole            String?    @map("sole") @db.VarChar(200)
  soleAddition    String?    @map("sole_addition") @db.VarChar(200)
  soleColor       String?    @map("sole_color") @db.VarChar(200)
  additions       String?    @map("additions") @db.VarChar(200)
  aField          String?    @map("a_field") @db.VarChar(200)
  fField          String?    @map("f_field") @db.VarChar(200)
  sideNotes       String?    @map("side_notes") @db.VarChar(4000)
  createdAt       DateTime   @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @map("updated_at") @db.Timestamptz(6)
  removedAt       DateTime?  @map("removed_at") @db.Timestamptz(6)
  draft           SalesDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@index([draftId, removedAt, position], map: "sales_draft_pieces_draft_removed_position_idx")
  @@map("sales_draft_pieces")
}

model SalesCommand {
  commandId       String                @id(map: "sales_commands_pkey") @map("command_id") @db.Uuid
  operation       SalesCommandOperation
  actorId         String                @map("actor_id") @db.Uuid
  actorFullName   String                @map("actor_full_name") @db.VarChar(150)
  actorRole       UserRole              @map("actor_role")
  actorDepartment Department?           @map("actor_department")
  requestTargetId String?               @map("request_target_id") @db.Uuid
  customerId      String?               @map("customer_id") @db.Uuid
  draftId         String?               @map("draft_id") @db.Uuid
  expectedVersion Int?                  @map("expected_version")
  beforeVersion   Int?                  @map("before_version")
  afterVersion    Int                   @map("after_version")
  payloadHash     String                @map("payload_hash") @db.Char(64)
  before          Json?                 @db.JsonB
  after           Json                  @db.JsonB
  occurredAt      DateTime              @map("occurred_at") @db.Timestamptz(6)
  actor           User                  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  customer        Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  draft           SalesDraft?           @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@index([draftId, occurredAt(sort: Desc), commandId(sort: Desc)], map: "sales_commands_draft_occurred_id_idx")
  @@index([actorId, occurredAt(sort: Desc), commandId(sort: Desc)], map: "sales_commands_actor_occurred_id_idx")
  @@map("sales_commands")
}
